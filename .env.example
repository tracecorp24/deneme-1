# =====================================================================
# VFS Global Bulgaristan Vize Botu - Ortam Değişkenleri (.env.example)
# Bu dosyayı .env olarak kopyalayın ve kendi bilgilerinizi doldurun.
# =====================================================================

# VFS Global lift-api x-auth-token (scripts/find_token.py ile tespit edilir)
VFS_X_TOKEN=

# Residential / ISP Proxy Havuzu (Virgülle ayrılmış liste)
# Örnek: http://user:pass@ip1:port,http://user:pass@ip2:port
VFS_PROXIES=

# Tarayıcı Görünürlüğü (True: Arka planda çalışır, False: Görünür pencere açılır)
VFS_HEADLESS=false

# Telegram Bot Bildirim Ayarları
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Otomatik Rezervasyon (True: Slot bulunur bulunmaz rezervasyon yapar, False: Bildirim atar)
AUTO_BOOK=false

# Excel Başvuranlar Tablosu Yolu
EXCEL_PATH=data/basvuranlar.xlsx

# IMAP E-Posta / OTP Ayarları
OTP_IMAP_PORT=993
OTP_SENDER=vfsglobal
